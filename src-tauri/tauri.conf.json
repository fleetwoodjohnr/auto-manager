{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auto Manager",
  "mainBinaryName": "auto-manager",
  "identifier": "dev.automanager.desktop",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Auto Manager",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "freezePrototype": false,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1440",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Vehicle lookup, parts, inventory and service management",
    "longDescription": "Decode a VIN, see verified specifications, find fitting parts and manuals, check inventory, and manage pricing, estimates and service jobs. Local-first and private.",
    "copyright": "Auto Manager contributors",
    "license": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBQkIzMTk3N0FFMjAzNzIKUldSeUErSjZsekc3Q21WV0J5NTkrU1pDTEV6NVBlMXBDYkphaXlpbDRxd3lMWlVHT1hQMno4VlYK",
      "endpoints": ["https://github.com/fleetwoodjohnr/auto-manager/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
